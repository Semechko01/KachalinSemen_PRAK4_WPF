<Window x:Class="KachalinSemen_PRAK4_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KachalinSemen_PRAK4_WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel>
            <Label Content="Наименование"/>
            <Label Content="Цена"/>
            <Label Content="Количество"/>
            <Label Content="Скидка"/>
        </StackPanel>
        <StackPanel Grid.Column="1">

            <TextBox Margin="5" Text="{Binding NAME,UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Margin="5" Text="{Binding PRICE,UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Margin="5" Text="{Binding COUNT,UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Margin="5" Text="{Binding SKIDKA,UpdateSourceTrigger=PropertyChanged}"/>
            <Button Click="Save">Cохранить</Button>
            <Button Click="New">Новая запись</Button>
            <TextBox x:Name ="TextBoxSearchID" Margin="5" Text=""/>
            <Button Click="SearchID">Поиск по ID</Button>
            
        </StackPanel>
        <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="4">
            <TextBlock Text="ID:"/>
            <TextBlock Text="{Binding ID}"/>
            <TextBlock Text="Имя:"/>
            <TextBlock Text="{Binding NAME}"/>
            <TextBlock Text="Цена:"/>
            <TextBlock Text="{Binding PRICE}"/>
            <TextBlock Text="Количество:"/>
            <TextBlock Text="{Binding COUNT}"/>
            <TextBlock Text="Скидка:"/>
            <TextBlock Text="{Binding SKIDKA}"/>
            <TextBlock Text="Итоговая стоимость"/>
            <TextBlock Text="{Binding ENDPRICE}"/>
            
        </StackPanel>

    </Grid>
</Window>
